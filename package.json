{
  "name": "tp1-perceptron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config tp1/vite.config.ts",
    "build": "tsc && vite build --config tp1/vite.config.ts",
    "preview": "vite preview --config tp1/vite.config.ts",
    "ng": "cd tp2 && ng",
    "tp2:ort": "bun tp2/scripts/copy-ort.ts",
    "tp2:dev": "bun run tp2:ort && cd tp2 && ng serve",
    "tp2:build": "bun run tp2:ort && cd tp2 && ng build",
    "tp4:ort": "bun tp4/scripts/copy-ort.ts",
    "tp4:dev": "bun run tp4:ort && vite --config tp4/vite.config.ts",
    "tp4:build": "bun run tp4:ort && tsc && vite build --config tp4/vite.config.ts",
    "tp5:ort": "bun tp5/scripts/copy-ort.ts",
    "tp5:dev": "bun run tp5:ort && vite --config tp5/vite.config.ts",
    "tp5:build": "bun run tp5:ort && tsc && vite build --config tp5/vite.config.ts",
    "tp6:ort": "bun tp6/scripts/copy-ort.ts",
    "tp6:dev": "bun run tp6:ort && vite --config tp6/vite.config.ts",
    "tp6:build": "bun run tp6:ort && tsc && vite build --config tp6/vite.config.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "onnxruntime-web": "^1.22.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^6.0.0"
  }
}
